# Arellan Frontend Web — Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_APP_NAME=Arellan Autos — Panel
NEXT_PUBLIC_UPLOAD_URL=http://localhost:3001/uploads

# ─── Sesión (SEC-04/SEC-09) — variables SOLO de servidor (sin NEXT_PUBLIC) ───
# URL del backend para los route handlers BFF (/api/auth/*)
API_URL=http://localhost:3001/api/v1
# SEC-09: el middleware verifica la firma HS256 de la cookie de sesión.
# DEBE coincidir con JWT_ACCESS_SECRET del backend. Consecuencia de HS256
# simétrico (ver SEC-17); con RS256 bastaría la clave pública.
JWT_ACCESS_SECRET=change-me-to-the-same-backend-access-secret
